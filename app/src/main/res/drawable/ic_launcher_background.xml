<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon layer for The Gallery: warm orange backdrop, white cards, coral accent. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Warm orange gradient; keep the corners clean under square launcher masks. -->
    <path
        android:pathData="M0.00,0.00 H108.00 V108.00 H0.00 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item
                    android:offset="0"
                    android:color="#FFFFF3E2" />
                <item
                    android:offset="0.55"
                    android:color="#FFFFD8AA" />
                <item
                    android:offset="1"
                    android:color="#FFF2A257" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
